{
  "name": "taskhub",
  "private": true,
  "version": "0.0.1",
  "description": "Task Management Application",
  "author": "Quoc Lien",
  "license": "MIT",
  "scripts": {
    "dev:web": "pnpm --filter @taskhub/web dev",
    "build:web": "pnpm --filter @taskhub/web build",
    "start:web": "pnpm --filter @taskhub/web start",
    "dev:api": "dotnet watch --project apps/api/TaskHub.Api.csproj",
    "build:api": "dotnet build apps/api/TaskHub.Api.csproj",
    "start:api": "dotnet run --project apps/api/TaskHub.Api.csproj"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint-staged"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.0.0",
    "vite": "^5.1.4",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.3.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^8",
    "@dnd-kit/utilities": "^3"
  }
}