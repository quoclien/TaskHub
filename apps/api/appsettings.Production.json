{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "${MONGODB_CONNECTION_STRING}",
    "DatabaseName": "TaskHub_Prod"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "TaskHub",
    "Audience": "TaskHub-Users",
    "ExpireDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://taskhub.yourdomain.com"
    ]
  }
}
