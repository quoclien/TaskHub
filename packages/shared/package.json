{
  "name": "@taskhub/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for TaskHub",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "zod": "^3.25.67"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quoclien/TaskHub.git"
  },
  "keywords": [
    "taskhub",
    "shared",
    "types",
    "utilities"
  ],
  "author": "Quoc Lien",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/quoclien/TaskHub/issues"
  },
  "homepage": "https://github.com/quoclien/TaskHub#readme"
}
